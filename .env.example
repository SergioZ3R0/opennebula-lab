# OpenNebula version (packages from downloads.opennebula.io)
ONE_VERSION=7.4
DEBIAN_RELEASE=13

# Registry for published images (build locally if unset)
REGISTRY=ghcr.io
IMAGE_OWNER=sergioz3r0

# Lab credentials
ONEADMIN_PASSWORD=opennebula

# Hosts to auto-register on the front-end (space separated)
REGISTER_HOSTS=node1

# dummy | nat | none
SEED_NETWORK=dummy

# Download + import a tiny Alpine cloud image on first boot
SEED_TINY_IMAGE=false
TINY_IMAGE_URL=https://dl-cdn.alpinelinux.org/alpine/v3.20/releases/cloud/nocloud_alpine-3.20.0-x86_64-bios-cloudinit-r0.qcow2

# Create bridge br0 + MASQUERADE on nodes (use with SEED_NETWORK=nat)
SETUP_NAT=false

# Host ports
XMLRPC_PORT=2633
FIREEDGE_PORT=2616
SSH_PORT=2222
# VM VNC consoles on the node (5900 + display)
VNC_PORT_RANGE=5900-5915
