# OpenNebula version (packages from downloads.opennebula.io)
ONE_VERSION=7.4
DEBIAN_RELEASE=13

# Registry for published images (build locally if unset)
REGISTRY=ghcr.io
IMAGE_OWNER=sergioz3r0

# Lab credentials
ONEADMIN_PASSWORD=opennebula

# Hosts to auto-register on the front-end (space separated)
REGISTER_HOSTS=node1

# dummy | nat | none
# nat = lab-nat (bridge br0 + internet via MASQUERADE) + lab-public (dummy)
SEED_NETWORK=nat

# Download + import a bootable Ubuntu cloud image on first boot (SSH + cloud-init)
SEED_UBUNTU_IMAGE=true
UBUNTU_IMAGE_URL=https://cloud-images.ubuntu.com/releases/24.04/release/ubuntu-24.04-server-cloudimg-amd64.img
UBUNTU_IMAGE_NAME=ubuntu-cloud
UBUNTU_TEMPLATE_NAME=ubuntu-cloud-ssh
UBUNTU_VCPU=1
UBUNTU_MEMORY=1024

# Optional tiny Alpine image (no default credentials; lifecycle tests only)
SEED_TINY_IMAGE=false
TINY_IMAGE_URL=https://dl-cdn.alpinelinux.org/alpine/v3.20/releases/cloud/nocloud_alpine-3.20.0-x86_64-bios-cloudinit-r0.qcow2
TINY_IMAGE_NAME=alpine-tiny

# Create bridge br0 + MASQUERADE on nodes (required for SEED_NETWORK=nat)
SETUP_NAT=true

# Host ports
XMLRPC_PORT=2633
FIREEDGE_PORT=2616
SSH_PORT=2222
# VM VNC consoles on the node (5900 + display)
VNC_PORT_RANGE=5900-5915
